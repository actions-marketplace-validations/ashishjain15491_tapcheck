{
    // Type-checks src/, test/ and the example flow (npm run typecheck); tsconfig.build.json emits dist/ from src/ alone.
    "compilerOptions": {
        "target": "es2023",
        "lib": ["es2023", "dom", "dom.iterable"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true, // bin/tapcheck runs src/ through Node's type stripping, which only erases
        "rewriteRelativeImportExtensions": true,
        "noEmit": true,
        "paths": { "tapcheck": ["./src/flow.ts"] } // what the example flow imports, before there is a dist/
    },
    "include": ["src", "test", "examples"]
}
